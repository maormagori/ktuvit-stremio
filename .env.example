KTUVIT_USER_EMAIL=your.ktuvit.user.email.address
KTUVIT_USER_HASHED_PASSWORD=your.ktuvit.user.hashed.password
# Hostname or LAN IP advertised in subtitle URLs, without scheme or port.
ADDON_HOSTNAME=localhost
# Host-side port; change this if port 3000 is already used on the Docker host.
# When changing it, set PUBLIC_URL to the URL clients use (including its port).
ADDON_BIND_PORT=3000
# External origin when using an HTTPS reverse proxy, e.g. Tailscale Serve.
# PUBLIC_URL=https://your-pi.your-tailnet.ts.net
